# ── Firebase project credentials ─────────────────────────────
# Copy this file to .env and fill in your Firebase project values.
# Find these in Firebase Console → Project Settings → Your apps → SDK setup.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ── Player URL ───────────────────────────────────────────────
# The URL shown on the lobby QR code. Set this to your deployed player URL.
# Default (if omitted): https://durian-rush-kl.web.app/play

VITE_PLAY_URL=https://your-project-id.web.app/play

# ── Admin email ──────────────────────────────────────────────
# The email you will use to log into /admin (presenter controls).
# Must match the email in database.rules.json AND in Firebase Auth → Users.
# Create this user in Firebase Console → Authentication → Users → Add user.
# This value is NOT read by the app — it's here as a reminder.

ADMIN_EMAIL=you@youruniversity.edu
